{
  "name": "electron-app",
  "version": "0.1.0",
  "private": true,
  "main": "lib/backend/electron-main.js",
  "scripts": {
    "build": "theia build --mode development",
    "start": "theia start --plugins=local-dir:../app/plugins",
    "watch": "theia build --watch --mode development"
  },
  "dependencies": {
    "@theia/core": "~1.74.1",
    "@theia/editor": "~1.74.1",
    "@theia/filesystem": "~1.74.1",
    "@theia/markers": "~1.74.1",
    "@theia/messages": "~1.74.1",
    "@theia/monaco": "~1.74.1",
    "@theia/navigator": "~1.74.1",
    "@theia/outline-view": "~1.74.1",
    "@theia/plugin-ext": "~1.74.1",
    "@theia/plugin-ext-vscode": "~1.74.1",
    "@theia/preferences": "~1.74.1",
    "@theia/process": "~1.74.1",
    "@theia/property-view": "~1.74.1",
    "@theia/scm": "~1.74.1",
    "@theia/workspace": "~1.74.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "catenary": "workspace:*",
    "@theia/electron": "~1.74.1"
  },
  "devDependencies": {
    "@theia/cli": "~1.74.1",
    "electron": "42.3.0"
  },
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Catenary",
        "defaultTheme": "dark",
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "files.autoSave": "off",
          "workbench.colorTheme": "dark"
        }
      }
    }
  }
}
