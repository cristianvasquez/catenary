    "@ro-kit/ui-widgets": "^1.0.64",
    "@theia/debug": "~1.74.1",
    "@theia/test": "~1.74.1",
    "@theia/task": "~1.74.1",
    "@theia/terminal": "~1.74.1",
    "@catenary/model": "workspace:*",
    "@catenary/rdf": "workspace:*",
    "@ulb-darmstadt/shacl-form": "^3.7.3",
    "elkjs": "^0.11.1",
    "jsonld": "^9.0.0",
    "lit": "^3.3.3",
    "n3": "^2.7.12",
    "rdfxml-streaming-parser": "^3.3.0",
