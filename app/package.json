{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "theia build --mode development",
    "rebuild": "theia rebuild:browser --cacheRoot ..",
    "start": "bash ../scripts/start-browser.sh",
    "watch": "theia build --watch --mode development",
    "download:plugins": "theia download:plugins --rate-limit=15 --parallel=false"
  },
  "dependencies": {
    "@theia/core": "~1.74.1",
    "@theia/editor": "~1.74.1",
    "@theia/filesystem": "~1.74.1",
    "@theia/markers": "~1.74.1",
    "@theia/messages": "~1.74.1",
    "@theia/monaco": "~1.74.1",
    "@theia/navigator": "~1.74.1",
    "@theia/outline-view": "~1.74.1",
    "@theia/plugin-ext": "~1.74.1",
    "@theia/plugin-ext-vscode": "~1.74.1",
    "@theia/preferences": "~1.74.1",
    "@theia/process": "~1.74.1",
    "@theia/property-view": "~1.74.1",
    "@theia/scm": "~1.74.1",
    "@theia/workspace": "~1.74.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "catenary": "workspace:*"
  },
  "devDependencies": {
    "@theia/cli": "~1.74.1"
  },
  "theia": {
    "target": "browser",
    "frontend": {
      "config": {
        "applicationName": "Catenary",
        "defaultTheme": "dark",
        "preferences": {
          "files.enableTrash": false,
          "security.workspace.trust.enabled": false,
          "files.autoSave": "off",
          "workbench.colorTheme": "dark"
        },
        "reloadOnReconnect": true
      }
    }
  },
  "theiaPluginsDir": "plugins",
  "theiaPlugins": {
    "vscode.git": "https://open-vsx.org/api/vscode/git/1.95.3/file/vscode.git-1.95.3.vsix",
    "vscode.git-base": "https://open-vsx.org/api/vscode/git-base/1.95.3/file/vscode.git-base-1.95.3.vsix"
  }
}
