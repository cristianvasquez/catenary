  sh:name "description";
  sh:order 1;
  sh:path dct:description.

<urn:skolem:bb3bd1a3-aa35-4589-a04a-72b952885075>
  sh:datatype xsd:string;
  sh:description "What the product provides.";
  sh:maxCount 1;
  sh:message "A data product needs a description.";
  sh:minCount 1;
  sh:name "description";
  sh:order 1;
  sh:path dct:description.

<urn:skolem:bdafab0d-5899-4d3e-8a9a-e6c93765b6da>
  sh:class dcat:DataService;
  sh:description "Service that the product reads from.";
  sh:name "input port";
  sh:order 12;
  sh:path dprod:inputPort.

<urn:skolem:bf5e8cae-e0f5-4a04-8d5a-751d07415b57>
  sh:class dcat:DataService;
  sh:name "is exposed through";
  sh:order 10;
  sh:path dpm:exposedThrough.

<urn:skolem:bf9192d4-52b2-4245-8cd5-498b37d69520>
  sh:class dcat:DataService;
  sh:name "is exposed through";
  sh:order 10;
  sh:path dpm:exposedThrough.

<urn:skolem:c2622c06-0267-4332-ae4d-5bf66d2f25ac>
  sh:datatype xsd:string;
  sh:maxCount 1;
  sh:minCount 1;
  sh:name "label";
  sh:order 0;
  sh:path rdfs:label.

<urn:skolem:c4b39226-bf33-4801-85fc-29ee4a6dfc77>
  sh:class dcat:Dataset;
  sh:name "output dataset";
  sh:order 15;
  sh:path dprod:outputDataset.

<urn:skolem:c6391ebb-1a17-47b4-9729-2c9d01015e5f>
  sh:class dpm:Domain;
  sh:maxCount 1;
  sh:name "domain";
  sh:order 11;
  sh:path dprod:domain.

<urn:skolem:cfc1d34f-0530-4cc4-9a91-c3e10c15294f>
  rdf:first "replace";
  rdf:rest rdf:nil.

<urn:skolem:d344808d-c0d7-4f8f-91db-6a947a145980>
  sh:datatype xsd:string;
  sh:maxCount 1;
  sh:name "description";
  sh:order 1;
  sh:path dct:description.

<urn:skolem:d41c7344-1e32-4bf6-a409-0456e7b845d4>
  rdf:first "Ideation";
  rdf:rest <urn:skolem:6667f226-6b17-4ffb-88df-557fe9b8f7c5>.

<urn:skolem:dbecb8a7-4247-4749-a778-6fc50690c5d1>
  sh:datatype xsd:string;
  sh:maxCount 1;
  sh:name "description";
  sh:order 1;
  sh:path dct:description.

<urn:skolem:dd105f9e-e985-47f9-afb9-1b593059c3b8>
  sh:datatype xsd:string;
  sh:maxCount 1;
  sh:minCount 1;
  sh:name "label";
  sh:order 0;
  sh:path rdfs:label.

<urn:skolem:e788de3b-1e30-4b9d-b5ac-0166239895ec>
  sh:datatype xsd:string;
  sh:description "Template of the graph IRI, for example {base}/graph/decisions/{year}.";
  sh:maxCount 1;
  sh:name "IRI pattern";
  sh:order 1;
  sh:path dpm:pattern.

<urn:skolem:e8dec723-cecc-4339-bb2e-c89c136a3671>
  rdf:first "append";
  rdf:rest <urn:skolem:cfc1d34f-0530-4cc4-9a91-c3e10c15294f>.

<urn:skolem:ef1121ab-aa60-44ef-9657-51ef04bfb394>
  sh:datatype xsd:string;
  sh:description "The question that the product answers for its consumers.";
