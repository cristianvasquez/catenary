<urn:name:English> a <http://purl.org/dc/terms/LinguisticSystem>;
  <http://www.w3.org/2000/01/rdf-schema#label> "English".

<urn:name:Event%20stream> a <http://www.w3.org/ns/dcat#Dataset>;
  <http://example.org/vocab#hasData> "NonPersonalData";
  <http://purl.org/dc/terms/language> <urn:name:English>;
  <http://purl.org/dc/terms/title> "Application event stream";
  <http://www.w3.org/2000/01/rdf-schema#label> "Event stream";
  <http://www.w3.org/ns/dcat#keyword> "events";
  <http://www.w3.org/ns/dcat#theme> <http://example.org/vocab#product-analytics>.

<urn:name:Open%20data> a <http://www.w3.org/ns/dcat#Catalog>;
  <http://purl.org/dc/terms/title> "Open data";
  <http://www.w3.org/2000/01/rdf-schema#label> "Open data";
  <http://www.w3.org/ns/dcat#dataset>
    <urn:name:Event%20stream>,
    <urn:name:Usage%20metrics>.

<urn:name:Usage%20metrics> a <http://www.w3.org/ns/dcat#Dataset>;
  <http://example.org/vocab#hasData> "NonPersonalData";
  <http://purl.org/dc/terms/language> <urn:name:English>;
  <http://purl.org/dc/terms/title> "Application events";
  <http://www.w3.org/2000/01/rdf-schema#label> "Usage metrics";
  <http://www.w3.org/ns/dcat#keyword> "usage";
  <http://www.w3.org/ns/dcat#theme> <http://example.org/vocab#product-analytics>.
