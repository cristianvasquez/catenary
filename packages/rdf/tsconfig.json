{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "lib",
    "types": [
      "node"
    ],
    "composite": true
  },
  "include": [
    "src"
  ],
  "references": [
    {
      "path": "../shacl"
    },
    {
      "path": "../model"
    },
    {
      "path": "../rdf-files"
    }
  ]
}
