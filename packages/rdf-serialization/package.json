{
  "name": "rdf-serialization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vendored RDF canonicalization and Turtle/TriG serialization used by Catenary.",
  "main": "lib/index.cjs",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js",
      "require": "./lib/index.cjs"
    }
  },
  "files": [
    "src",
    "LICENSE",
    "readme.md"
  ],
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --format=cjs --outfile=lib/index.cjs",
    "test": "vitest run --config ../../vitest.config.mts packages/rdf-serialization/test"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@rdfjs/serializer-turtle": "1.1.5",
    "@rdfjs/to-ntriples": "3.0.1",
    "rdf-canonize": "5.0.0",
    "rdf-ext": "2.6.0",
    "@rdfjs/types": "^2.0.1"
  }
}
