+// A list is written as a collection "( … )" only when each cell is a blank node, used once, with one rdf:first and one rdf:rest.
+// Otherwise (IRI cells) the cells are also written as subjects and the output parses to a second, blank-node list.
+function isCollection (node) {
+  if (!node.items) {
+    return node.term.value === 'http://www.w3.org/1999/02/22-rdf-syntax-ns#nil'
+  }
+
+  return node.items.every(cell => cell.term.termType === 'BlankNode' && cell.refs.length === 1 && cell.quads.length === 2)
+}
+
 class TurtleSerializer {
   constructor (quads, { baseIRI, output = [], prefixes } = {}) {
     this.baseIRI = baseIRI
